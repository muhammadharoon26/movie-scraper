# ─── Database ──────────────────────────────────────────────
# PostgreSQL connection string (used locally; Docker Compose overrides this)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=movie_scraper
DATABASE_URL=postgresql://postgres:change-me-to-a-strong-password@localhost:5432/movie_scraper

# ─── JWT Authentication ───────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-random-256-bit-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ─── Admin Seed ───────────────────────────────────────────
# Credentials for the initial admin user created by seed.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ─── TMDB API ─────────────────────────────────────────────
# API key
TMDB_API_KEY=your-tmdb-api-keyy

# ─── Scraper Configuration ────────────────────────────────
# Number of pages to fetch from TMDB trending endpoint (20 items/page)
SCRAPER_MAX_PAGES=5
# Delay between page requests in seconds (rate-limit courtesy)
SCRAPER_PAGE_DELAY_SECONDS=0.5

# ─── Redis (Bonus — Celery broker/backend) ────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Application ──────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
